{
  "manifest_version": 3,
  "name": "Petulap Sales CRM - WhatsApp Assistant Pro",
  "version": "1.1.0",
  "description": "Inspector pasivo del DOM, semáforo de 4 temperaturas, recordatorios y notificaciones de citas en Yanahuara/Cayma para WhatsApp Web.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "https://petulap.store/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
